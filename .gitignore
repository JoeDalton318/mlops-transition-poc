.tox/
.nox/
.coverage
coverage.xml
*.cover
*.coveragerc
.hypothesis/
.mypy_cache/
.pyre/
.ruff_cache/

########################################
# MLOps / Data / Models / Logs
########################################

# Local MLflow tracking and artifacts
/mlruns/
# SQLite backend store for MLflow tracking (local runtime state, regenerated by train.py)
mlflow.db
mlflow.db-*

# Typical model / artifact directories
/artifacts/
/models/
/checkpoints/
logs/
/reports/
drift_reports/

# Local data and generated assets
*.csv
*.tsv
*.parquet
*.h5
*.hdf5
*.npz
*.npy
*.feather
*.dat
*.zip
*.tar
*.jsonl
*.log

# Serialized models and checkpoints
*.pkl
*.joblib
*.model
*.ckpt

########################################
# Jupyter
########################################

.ipynb_checkpoints/
*.ipynb_checkpoints

########################################
# IDEs, editors & OS files
########################################

.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
*~
.nfs*

########################################
# Docker & CI
########################################

# NOTE (correction, sept. 2026) : Dockerfile, docker-compose*.yml et .dockerignore
# sont volontairement retirés de ce fichier. Ce sont des fichiers d'infrastructure-
# as-code versionnés, pas des artefacts générés — un précédent réglage ici les
# excluait par erreur du suivi Git alors qu'ils sont indispensables à la
# reproductibilité du build (et référencés tels quels par le pipeline CI).
# NOTE (correction, Sept. 2026): Dockerfile, docker-compose*.yml and
# .dockerignore are intentionally removed from this file. They are versioned
# infrastructure-as-code, not generated artifacts — a previous rule here
# mistakenly excluded them from Git tracking even though they are essential to
# build reproducibility (and referenced as-is by the CI pipeline).

# CI caches and temporary files
.cache/

########################################
# Secrets, keys & credentials
########################################

*.pem
*.key
*.crt
credentials
secret*
secrets.yml

########################################
# Logs, runtime files
########################################

*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/

########################################
# Misc
########################################

# OS generated files
Icon?

# Backup and temp files
*.bak
*.tmp
~*$

########################################
# Mémoire de recherche & documents LaTeX
########################################
memoire/
*.tex
*.pdf
*.aux
*.bbl
*.bcf
*.blg
*.log
*.out
*.run.xml
*.toc
*.lof
*.lot

# LLM / Assistant instructions
CLAUDE.md

