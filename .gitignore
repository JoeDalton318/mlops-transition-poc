# .gitignore — Professionnel pour Python + MLOps
# .gitignore — Professional for Python + MLOps

########################################
# Environnements virtuels / Virtual envs
########################################

# Common Python virtual environment folders
.venv/
venv/
env/
ENV/

# Pipenv / Poetry / pyenv
/.venv
Pipfile.lock
.python-version

# Environment variable files (secrets)
.env
.env.*

########################################
# Python & build artefacts
########################################

__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
eggs/
parts/
sdist/
develop-eggs/
pip-wheel-metadata/
wheelhouse/
htmlcov/
