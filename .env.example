# ==============================================================================
# Configuration globale de l'environnement (Global Environment Configuration)
# ==============================================================================
#
# Modèle à copier vers .env avant toute exécution locale ou Docker :
#   Windows   : copy .env.example .env
#   Linux/mac : cp .env.example .env
#
# Ce fichier ne contient aucun secret : uniquement des ports, des URL locales et
# des chemins relatifs. Le projet n'utilise ni clé d'API, ni mot de passe, ni
# jeton. Si une telle valeur devenait nécessaire, elle irait dans .env (ignoré
# par Git) et ce modèle n'en contiendrait que le nom, avec une valeur fictive.
#
# Toutes les variables ci-dessous sont facultatives : le code applique les mêmes
# valeurs par défaut si elles sont absentes. En revanche, le fichier .env
# lui-même est obligatoire pour docker compose, qui le charge via env_file.
# This template contains no secret: ports, local URLs and relative paths only.
# Every variable below is optional (the code applies the same defaults), but the
# .env file itself is required by docker compose (env_file).

# API Configuration / Configuration de l'API
API_HOST=0.0.0.0
API_PORT=8000
# Utilisé par le dashboard pour contacter l'API (used by dashboard to reach API)
API_BASE_URL=http://localhost:8000

# Dashboard Configuration / Configuration du Dashboard Streamlit
DASHBOARD_PORT=8501

# MLflow Configuration / Configuration du serveur MLflow
# L'URI du tracking MLflow (MLflow tracking URI)
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_PORT=5000
MLFLOW_BACKEND_STORE_URI=sqlite:///mlflow.db
MLFLOW_DEFAULT_ARTIFACT_ROOT=./mlruns

# Data & Models Configuration / Chemins des données et modèles
DATA_FILE_PATH=data/immobilier_france.csv
MODELS_DIR=models
DRIFT_REPORTS_DIR=drift_reports

# Porte de promotion champion/challenger (src/train.py) : gain minimal de R2
# exigé d'un challenger pour devenir champion. 0.0 = toute amélioration stricte.
# Champion/challenger promotion gate: minimum R2 gain required, 0.0 = any strict
# improvement.
PROMOTION_MIN_GAIN=0.0
